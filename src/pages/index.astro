---
import Base from '../layouts/Base.astro';
import TodayCard from '../components/TodayCard.astro';
import { site, units, YEAR_NAMES, u, weekVerses, stats } from '../lib/data.js';
const steps = [
  ['1', 'Reading', 'Read the passage in your own Bible, with a note on what to watch for.'],
  ['2', 'Setting the Scene', 'Where we are in the story and why it matters.'],
  ['3', 'Observation', 'What the text actually says, before we interpret it.'],
  ['4', 'Interpretation', 'What it meant, and how it fits the whole Bible.'],
  ['5', 'Connection', 'Where the rest of Scripture echoes this passage.'],
  ['6', 'Application', 'Questions that turn the truth toward your own life.'],
  ['7', 'Respond in Prayer', 'Two or three prompts. Answer God in your own words.'],
];
const y1 = units.filter((x) => x.year === 1), y2 = units.filter((x) => x.year === 2);
---
<Base title="" description={site.intro}>
  <div class="wrap">
    <section class="hero">
      <div class="l">
        <div class="label">A 900-Day Path Through Scripture</div>
        <h1>{site.tagline}</h1>
        <p class="lead">{site.intro}</p>
        <div class="ctas">
          <a class="btn primary" data-continue href={u('day/1/')}>Continue <span data-continue-n>Day 1</span></a>
          <a class="btn" href={u('plan/')}>Browse the plan</a>
        </div>
      </div>
      <div class="r" style="padding:0;display:block;background:none;border:0;outline:0;margin:0"><TodayCard /></div>
    </section>
  </div>

  <div class="band" data-welcome>
    <div class="wrap welcome">
      <div>
        <div class="label">New here?</div>
        <h2>Start with two short reads</h2>
        <p class="muted" style="margin:.4rem 0 0;max-width:40rem">A guide to how the plan works, and a note about who wrote it and where he stands. Together they take about ten minutes.</p>
      </div>
      <div class="ctas" style="display:flex;gap:.8rem;flex-wrap:wrap">
        <a class="btn primary" href={u('how-to-use/')}>How to use this plan</a>
        <a class="btn" href={u('author-note/')}>An author&#8217;s note</a>
      </div>
    </div>
  </div>

  <div class="wrap">
    <section class="section" style="padding-top:3.5rem">
      <div class="center" style="margin-bottom:1.6rem">
        <div class="label">Your Journey</div>
        <h2 style="margin:.4rem 0">Twenty-five units</h2>
        <div class="muted" style="font-style:italic">Each square is a unit. Dark squares are finished.</div>
      </div>
      <div class="journey">
        {units.map((x) => <a href={u(`unit/${x.id}/`)} data-unit-first={x.firstDay} data-unit-last={x.lastDay} title={`Unit ${x.id}: ${x.title}`}>{x.id}</a>)}
      </div>
      <div class="years">
        <div style={`flex:${y1.length} 1 14rem`}><div class="label">Year 1</div><div style="font-size:1.3rem;font-style:italic">{YEAR_NAMES[1]}</div><div class="muted">Genesis through the prophets. Units 1-{y1.length}.</div></div>
        <div style={`flex:${y2.length} 1 12rem`}><div class="label">Year 2</div><div style="font-size:1.3rem;font-style:italic">{YEAR_NAMES[2]}</div><div class="muted">The Gospels through Revelation. Units {y2[0].id}-{y2[y2.length - 1].id}.</div></div>
      </div>
    </section>
  </div>

  <div class="band">
    <div class="wrap section" style="padding:3.5rem 2rem" data-today>
      <div class="center" style="margin-bottom:2rem">
        <div class="label">Coming Up</div>
        <h2 style="margin:.4rem 0">The next four days</h2>
      </div>
      <div class="grid g4" data-week-cards></div>
    </div>
  </div>

  <div class="wrap">
    <section class="section" style="padding:4rem 0" data-today>
      <div class="framed verse-panel">
        <div class="label" data-v="week">Memory Verse &middot; Week 1</div>
        <div class="v" data-v="text">&#8220;{weekVerses[0].text}&#8221;</div>
        <div class="label" style="color:var(--muted)" data-v="ref">{weekVerses[0].ref}</div>
      </div>
      <div class="center" style="margin-top:1.6rem"><a class="btn" href={u('memory/')}>All the memory verses</a></div>
    </section>

    <section class="section">
      <div class="center" style="margin-bottom:2rem">
        <div class="label">How Each Day Works</div>
        <h2 style="margin:.4rem 0">Seven steps, every day</h2>
        <p class="muted" style="max-width:40rem;margin:.4rem auto 0">You learn a method for reading Scripture while you read it.</p>
      </div>
      <div class="steps7">
        {steps.map(([n, h, b]) => <div><div class="n">{n}</div><div class="h">{h}</div><p>{b}</p></div>)}
      </div>
    </section>

    <section class="section" style="padding-bottom:1rem">
      <div class="center" style="margin-bottom:1.6rem">
        <div class="label">Companion Reference</div>
        <h2 style="margin:.4rem 0">Look things up as you go</h2>
      </div>
      <div class="grid g3">
        <a class="tile" href={u('doctrines/')}><div class="t">Doctrinal Pauses</div><div class="d">The {stats.doctrinal} days that stop the story to study one teaching of the faith, grouped by topic.</div></a>
        <a class="tile" href={u('psalms/')}><div class="t">The Psalms</div><div class="d">Why the Psalms are woven through all 900 days, and a guide to find any of the 150.</div></a>
        <a class="tile" href={u('books/')}><div class="t">The 66 Books</div><div class="d">Author, date, setting, theme, and an outline for every book, with the days that read it.</div></a>
        <a class="tile" href={u('glossary/')}><div class="t">Glossary</div><div class="d">Short definitions of the key terms the plan uses.</div></a>
        <a class="tile" href={u('checklist/')}><div class="t">Weekly Checklist</div><div class="d">All 129 weeks, Sunday to Saturday. Check off days as you finish them, or print it.</div></a>
        <a class="tile" href={u('downloads/')}><div class="t">PDF Downloads</div><div class="d">Printable editions of each unit and the whole plan.</div></a>
      </div>
    </section>
  </div>
</Base>
